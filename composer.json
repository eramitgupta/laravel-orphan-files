{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "erag/laravel-orphan-files",
    "description": "Find the uploaded files your Laravel app no longer uses, like old avatars and images from deleted posts, and clean them up safely with a preview and a restorable trash. Works with local disks, S3, MinIO and RustFS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/eramitgupta/laravel-orphan-files",
    "keywords": [
        "laravel",
        "laravel 12",
        "laravel 13",
        "storage cleanup",
        "delete unused files",
        "orphaned files",
        "orphan files",
        "unused images",
        "unused uploads",
        "s3",
        "minio",
        "rustfs",
        "filesystem",
        "disk space",
        "artisan"
    ],
    "authors": [
        {
            "name": "Er Amit Gupta",
            "email": "info.eramitgupta@gmail.com",
            "homepage": "https://github.com/eramitgupta"
        }
    ],
    "support": {
        "issues": "https://github.com/eramitgupta/laravel-orphan-files/issues",
        "source": "https://github.com/eramitgupta/laravel-orphan-files",
        "docs": "https://erag.in/laravel-orphan-files/",
        "security": "https://github.com/eramitgupta/laravel-orphan-files/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required to scan and batch-delete files on S3, MinIO, RustFS and other S3-compatible disks."
    },
    "autoload": {
        "psr-4": {
            "Erag\\OrphanFiles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --parallel",
        "test:lint": "pint --parallel --test",
        "test:unit": "pest --order-by=random",
        "test": [
            "@test:lint",
            "@test:unit"
        ],
        "demo": "vhs art/demo.tape"
    },
    "scripts-descriptions": {
        "demo": "Regenerate art/demo.gif with VHS (needs vhs, ttyd and ffmpeg)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Erag\\OrphanFiles\\OrphanFilesServiceProvider"
            ],
            "aliases": {
                "OrphanFiles": "Erag\\OrphanFiles\\Facades\\OrphanFiles"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
